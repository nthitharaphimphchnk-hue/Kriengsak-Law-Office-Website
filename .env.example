# โปรเจค Kriengsak Law Office – ตัวแปรสภาพแวดล้อม
# คัดลอกเป็น .env แล้วกรอกค่าจริง (ไม่ commit .env)

# แอป (Vite)
VITE_APP_ID=

# SEO – URL หลักของเว็บ (ใช้ใน canonical, sitemap, JSON-LD)
# ไม่ใส่ / ท้ายโดเมน
VITE_SITE_URL=https://www.kriengsaklawconsult.com

VITE_SITE_URL = https://www.kriengsaklawconsult.com
JWT_SECRET=

# Database (MySQL)
DATABASE_URL=mysql://user:password@localhost:3306/database_name

# OAuth (ถ้าใช้ล็อกอิน)
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Storage / Forge API (อัปโหลดไฟล์)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# เซิร์ฟเวอร์ (ถ้าไม่ตั้ง จะใช้ค่าเริ่มต้น)
# PORT=3000
